   "start": 21.29,
   "end": 25.161,
   "lines": [
    {
     "t": 0.458,
     "dur": 2.034,
     "text": "Riyadh's independent car market trades billions of riyals a year."
    },
    {
     "t": 2.747,
     "dur": 0.844,
     "text": "And no one had ever counted it."
    }
   ],
   "tr": "glitch"
  },
  {
   "id": "RDRONE",
   "start": 25.161,
   "end": 60.0,
   "lines": [
    {
     "t": 0.2,
