   "lines": [
    {
     "t": 0.282,
     "dur": 3.245,
     "text": "No one else holds this. The largest sub-dealer mapping of its kind, on one standard."
    }
   ],
   "tr": "punch"
  },
  {
   "id": "A3",
   "start": 69.677,
   "end": 76.452,
   "lines": [
    {
     "t": 0.307,
     "dur": 1.623,
     "text": "AutoLink brings financing to your floor."
    },
    {
     "t": 2.272,
     "dur": 4.127,
     "text": "Your team submits the buyer's request in the AutoLink dealer portal, and follows it, step by step."
    }
   ],
   "tr": "warp"
  },
  {
   "id": "A4",
   "start": 76.452,
   "end": 81.29,
   "lines": [
    {
     "t": 0.315,
     "dur": 2.151,
     "text": "Requests, reports and your account, in one dashboard."
    },
    {
     "t": 2.815,
     "dur": 1.639,
     "text": "In Arabic, in English, or in Chinese."
